# SPA root environment.
# Copy to '.env' and adjust. '.env' is git-ignored; never commit real secrets.
#
# This file only configures the docker-compose infrastructure.
# Application configuration lives in 'backend/.env' and 'frontend/.env.local'.

# PostgreSQL (Docker Compose).
POSTGRES_USER=spa
POSTGRES_PASSWORD=spa
POSTGRES_DB=spa

# Host port mapped to the container's 5432.
# Change this if another Postgres already listens on 5432 on your machine.
POSTGRES_PORT=5432

# Host port mapped to KeyDB's 6379 (the job queue and realtime fan-out).
# Change this if another service already listens on 6379, and keep
# SPA_KEYDB_URL in backend/.env in sync.
KEYDB_PORT=6379