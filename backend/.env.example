# SPA backend environment.
# Copy to 'backend/.env'. '.env' is git-ignored — never commit real secrets.
#
# Every variable is prefixed with SPA_ so it cannot collide with an ambient
# environment variable (DEBUG, ENVIRONMENT and friends are commonly already set
# by shells and CI runners; a collision either breaks startup or silently
# enables debug mode in production).

# SQLAlchemy connection URL. Driver is psycopg 3 ("postgresql+psycopg").
# Keep the port in sync with POSTGRES_PORT in the repository-root .env.
SPA_DATABASE_URL=postgresql+psycopg://spa:spa@localhost:5442/spa

# local | staging | production
SPA_ENVIRONMENT=local

# Enable verbose logging and debug behaviour. Must be false outside local.
SPA_DEBUG=false

# Log every SQL statement. Useful when diagnosing one query, very noisy generally.
SPA_DB_ECHO=false

# Comma-separated browser origins allowed to call the API (the Next.js app).
SPA_CORS_ORIGINS=http://localhost:3000

# Comma-separated trusted Host headers. Ignored outside production.
SPA_ALLOWED_HOSTS=*

# API version prefix. '/api/v1' is the contract the frontend consumes.
SPA_API_V1_PREFIX=/api/v1

# Project name shown in the OpenAPI document.
SPA_PROJECT_NAME=SPA API

# Video storage.
# local -> filesystem under SPA_STORAGE_LOCAL_ROOT
# s3    -> object storage (adapter not implemented yet)
SPA_STORAGE_BACKEND=local
SPA_STORAGE_LOCAL_ROOT=./var/storage
SPA_S3_ENDPOINT_URL=
SPA_S3_BUCKET=
SPA_S3_ACCESS_KEY_ID=
SPA_S3_SECRET_ACCESS_KEY=

# Max accepted upload size in bytes (default 10 GiB).
SPA_MAX_UPLOAD_BYTES=10737418240
# Lifetime of presigned upload and download URLs, in seconds.
SPA_UPLOAD_URL_TTL_SECONDS=3600
SPA_DOWNLOAD_URL_TTL_SECONDS=900

# Background jobs.
# inline -> write the job row and record the enqueue, without delivering it.
#           Lets the API run without KeyDB or a worker (development default).
# queued -> enqueue the job to KeyDB for a worker process ('make worker-dev').
SPA_JOB_BACKEND=inline

# KeyDB. Ephemeral state only: the job queue and realtime event fan-out.
# PostgreSQL remains the source of truth for every job.
# Keep the port in sync with KEYDB_PORT in the repository-root .env.
SPA_KEYDB_URL=redis://localhost:6379/0
SPA_KEYDB_DATABASE=0

# Seconds a claimed job stays with a worker before another may reclaim it. Must
# exceed the longest expected job so a healthy worker is not pre-empted.
SPA_JOB_VISIBILITY_TIMEOUT_SECONDS=300
# Total delivery attempts a job gets before it is left failed. Bounded on
# purpose: an unbounded retry loop hides a permanent failure.
SPA_JOB_MAX_ATTEMPTS=3
SPA_WORKER_CONCURRENCY=2

# Realtime processing events over WebSocket.
SPA_WEBSOCKET_HOST=ws.spanalysis.com
SPA_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000
# Computer-vision pipeline (implemented in ml/).
# Detector name resolved by the worker's detector registry, never a client-supplied
# path. 'hog_person' is the built-in OpenCV person detector and needs no weights.
SPA_CV_DETECTOR=hog_person
# Optional model weights path for detectors that require one. Empty means the
# detector's built-in default. Weights are never downloaded at startup.
SPA_CV_DETECTOR_MODEL_PATH=
SPA_CV_CONFIDENCE_THRESHOLD=0.5
# cpu | cuda. GPU is never required.
SPA_CV_DEVICE=cpu
# Run inference on every Nth frame.
SPA_CV_FRAME_INTERVAL=5
# Tracking rows persisted per database round-trip.
SPA_CV_TRACK_BATCH_SIZE=500
# Minimum person-box height in pixels for a detection to be kept.
SPA_CV_MIN_BOX_HEIGHT=24

# Required; use at least 32 characters (for example, 'openssl rand -hex 32').
# Every session, verification, reset and OTP secret is hashed with this value, so
# rotating it invalidates all outstanding challenges and sessions.
SPA_SESSION_SECRET=local-development-only-secret-change-me-32+

# Sessions. The cookie is HttpOnly and carries 'Secure' automatically outside
# 'local', so there is nothing to configure to get that right.
SPA_SESSION_COOKIE_NAME=spa_session
SPA_SESSION_TTL_HOURS=336
SPA_SESSION_IDLE_TIMEOUT_HOURS=168
# lax | strict | none. Leave as 'lax' when the frontend and API share a site.
SPA_SESSION_COOKIE_SAMESITE=lax
# Only enable when the frontend and API are genuinely on different sites; it
# forces SameSite=None and relies on the CSRF token alone.
SPA_SESSION_COOKIE_CROSS_SITE=false
SPA_CSRF_COOKIE_NAME=spa_csrf
SPA_CSRF_HEADER_NAME=X-CSRF-Token

# Development-only identity header. Has no effect in production: the dependency
# checks the environment independently of this flag.
SPA_DEV_IDENTITY_HEADER=true

# Transactional email. 'console' prints the message instead of sending it, so
# local development needs no provider credential.
SPA_EMAIL_BACKEND=console
SPA_EMAIL_FROM=SPA <no-reply@spa.local>
SPA_EMAIL_REPLY_TO=
# Required when SPA_EMAIL_BACKEND=resend.
SPA_RESEND_API_KEY=
SPA_SMTP_HOST=
SPA_SMTP_PORT=587
SPA_SMTP_USERNAME=
SPA_SMTP_PASSWORD=
SPA_SMTP_STARTTLS=true

# SMS delivery for phone verification. 'none' means no provider is configured:
# the phone endpoints answer 503 rather than pretending a code was sent.
SPA_SMS_BACKEND=none
SPA_SMS_SENDER=SPA
SPA_SMS_GATEWAY_DOMAIN=

# Account-security token lifetimes.
SPA_EMAIL_VERIFICATION_TTL_HOURS=48
SPA_PASSWORD_RESET_TTL_HOURS=2
SPA_EMAIL_CHANGE_TTL_HOURS=24
SPA_RECOVERY_TTL_HOURS=2
SPA_PASSWORD_MIN_LENGTH=10
SPA_PASSWORD_MAX_LENGTH=200
SPA_OTP_TTL_MINUTES=10
SPA_OTP_MAX_ATTEMPTS=5
SPA_OTP_RESEND_COOLDOWN_SECONDS=60
SPA_OTP_LENGTH=6

# Authentication rate limiting. 'keydb' shares counters across processes;
# 'process' is correct for a single process.
SPA_RATE_LIMIT_ENABLED=true
SPA_RATE_LIMIT_STORE=process
SPA_RATE_LIMIT_LOGIN_PER_MINUTE=10
SPA_RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_MINUTE=5
SPA_RATE_LIMIT_REGISTER_PER_HOUR=20
SPA_RATE_LIMIT_PASSWORD_RESET_PER_HOUR=10
SPA_RATE_LIMIT_RESEND_VERIFICATION_PER_HOUR=5
SPA_RATE_LIMIT_PHONE_PER_HOUR=10
