# Build output and generated artefacts.
#
# 'npm run format:check' runs 'prettier --check .', which walks the whole
# directory. Without this file it lints Next.js's own build output and reports
# formatting issues in files nobody authored — a check that fails for reasons
# unrelated to the code under review is a check people learn to skip.

.next/
out/
build/
coverage/

# Dependencies
node_modules/

# Lockfiles: regenerated by the package manager, not hand-formatted.
package-lock.json

# Environment files are deployment configuration, not source.
.env
.env.local
.env.*.local

# Next.js writes these.
next-env.d.ts