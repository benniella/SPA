# SPA frontend environment.
# Copy to 'frontend/.env.local'. '.env.local' is git-ignored.
#
# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser.
# Anything without that prefix stays server-side.

# Base URL of the FastAPI backend.
#
# This is the frontend's ONLY data source. The frontend never connects to
# PostgreSQL — see the architecture rule in docs/architecture/overview.md.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API version prefix. Kept separate from the base URL so that the version is
# visible in one place when '/api/v2' arrives.
NEXT_PUBLIC_API_VERSION_PREFIX=/api/v1

# Origin of the realtime processing service. Optional: when it is unset the
# frontend does not open a WebSocket and relies on reading processing state over
# HTTP, so a deployment without a realtime host still works.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Public origin this deployment is served from.
#
# Used for canonical URLs, Open Graph absolute URLs, sitemap.xml and robots.txt.
# Optional: 'lib/config.ts' validates the API variables and throws if they are
# missing, but this one has a localhost fallback so a preview build still emits
# valid metadata instead of failing.
#
# Set this in the Vercel project settings to the deployed origin, without a
# trailing slash. In local development the default is correct and can be omitted.
# NEXT_PUBLIC_SITE_URL=https://spa.example.com